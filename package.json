{
  "name": "flashami-money-form",
  "version": "1.0.0",
  "description": "Discord expense form for travel event operations",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "commands:register": "node --env-file=.env --import tsx scripts/register-commands.ts",
    "gas:check": "node scripts/check-gas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run gas:check && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "discord.js": "^14.27.0",
    "pino": "^9.14.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
